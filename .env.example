# Copy to .env if you want to override compose defaults.
# docker compose up works without an .env file.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret

KRATOS_DSN=postgres://kratos:secret@postgres:5432/kratos?sslmode=disable
HYDRA_DSN=postgres://hydra:secret@postgres:5432/hydra?sslmode=disable

COOKIE_SECRET=local-cookie-secret-change-me
CSRF_COOKIE_SECRET=local-csrf-secret-change-me

# First-party OAuth2 client id; also listed in TRUSTED_CLIENT_IDS
FIRST_PARTY_CLIENT_ID=nnf3-web
FIRST_PARTY_REDIRECT_URI=http://127.0.0.1:3000/callback
